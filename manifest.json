{
  "manifest_version": 3,
  "name": "YouTube Speed Buttons",
  "version": "1.0.0",
  "description": "在 YouTube 播放器上快速切換影片播放速度。",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
